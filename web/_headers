# Cloudflare static-assets headers (copied to public/ by scripts/stamp.mjs).
# index.html is always revalidated; app.js / styles.css carry a ?v=<build> query, so they can be cached.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: public, max-age=31536000, immutable
/styles.css
  Cache-Control: public, max-age=31536000, immutable
