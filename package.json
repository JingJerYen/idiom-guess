{
  "name": "idiom-charades",
  "version": "0.1.0",
  "description": "Practice English circumlocution by describing Chinese idioms to an AI",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "npm run build:web && tsx watch src/server.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "esbuild web/src/app.ts --bundle --format=esm --target=es2020 --outfile=public/app.js --minify && node scripts/stamp.mjs",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "mock": "npm run build:web && MOCK_MODE=1 tsx src/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JingJerYen/idiom-guess.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JingJerYen/idiom-guess/issues"
  },
  "homepage": "https://github.com/JingJerYen/idiom-guess#readme",
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "opencc-js": "^1.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/opencc-js": "^1.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
