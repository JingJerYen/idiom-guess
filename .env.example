# Server port (Render/Fly/Docker set this automatically)
PORT=3000

# Dedicated Anthropic API key for this game. Do NOT reuse ANTHROPIC_API_KEY.
# Leave empty to run in MOCK mode (no API calls).
GAME_ANTHROPIC_KEY=

# Force MOCK mode even when a key is present (1 = on)
MOCK_MODE=

# Max guesses per question (default 3)
MAX_GUESSES=3
# Thinking effort for the AI's final guess of each question: low | medium | high | off (default medium)
FINAL_GUESS_EFFORT=

# Set to 1 when running behind a reverse proxy (Render, Fly, nginx) so
# rate limiting sees the real client IP.
TRUST_PROXY=

# Optional: OpenAI key for Whisper speech-to-text and TTS clues. Leave empty to use the browser's
# built-in speech APIs instead. Never reuse OPENAI_API_KEY from other tools.
GAME_OPENAI_KEY=
# STT_MODEL=gpt-4o-mini-transcribe   TTS_MODEL=tts-1   TTS_VOICE=nova   DISABLE_STT=   DISABLE_TTS=

# Per-IP rate limits (requests per minute). Defaults: 30 for model endpoints, 120 for others.
RATE_LIMIT_MODEL_PER_MIN=
RATE_LIMIT_LIGHT_PER_MIN=
